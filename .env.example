# Copy to .env; never commit real credentials. Revoke previously exposed API keys.
GEMINI_API_KEY=
SAFE_BROWSING_API_KEY=
NEWS_MODEL=gemini-2.5-pro
SESSION_SECRET=
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
# Development HTTP only. Keep true behind production HTTPS.
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Separate random credentials of at least 32 characters for bots and admin review.
API_ACCESS_TOKEN=
ADMIN_API_KEY=
DB_URL=sqlite:///data/app.db
PROOF_STORAGE_DIR=data/proofs
IMAGE_MODEL_PATH=models_cache/ai-image-detector
IMAGE_MODEL_REVISION=
